# netgrab environment configuration.
#
# Copy to .env (gitignored) and fill in your values. Every command loads .env at
# startup (via godotenv). These override the matching fields in config/*.yaml,
# so no secret ever needs to live in a committed file.

# ── Device credentials (direct-SSH collectors + Orion inventory groups) ──────
DEVICE_USERNAME=
DEVICE_PASSWORD=
# Optional role-specific groups referenced by the inventory:
INFRA_ROUTER_USERNAME=
INFRA_ROUTER_PASSWORD=
CLIENT_ROUTER_USERNAME=
CLIENT_ROUTER_PASSWORD=

# Device inventory for cmd/local-storage and cmd/gitlab-storage
# (defaults to ./config/devices.example.yaml).
DEVICES_INVENTORY=./config/devices.yaml

# ── gnetcli gRPC server (orion-collect, -via gnetcli) ────────────────────────
GNETCLI_HOST=            # e.g. gnetcli.example.net
GNETCLI_PORT=50051
GNETCLI_LOGIN=
GNETCLI_PASSWORD=
# Or a pre-encoded base64("login:password") token instead of login/password:
GNETCLI_AUTH_TOKEN=
GNETCLI_TLS=false

# ── annet-oil HTTP execute API (orion-collect, -via annet-oil) ───────────────
ANNETOIL_BASE_URL=       # e.g. http://annet-oil.example.net:8181/api/v0
ANNETOIL_TOKEN=          # Bearer token

# ── Orion collection ─────────────────────────────────────────────────────────
INVENTORY_PATH=./config/inventory.orion.yaml
STORAGE_PATH=./tmp/local-storage
COLLECT_CONCURRENCY=20

# ── S3-compatible object storage (optional) ──────────────────────────────────
S3_ENABLED=false
S3_BUCKET=netgrab
S3_ENDPOINT=             # empty = AWS default; set for MinIO/other, e.g. http://minio.example.net:9000
S3_REGION=us-east-1
S3_USE_PATH_STYLE=false  # true for MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── GitLab storage (cmd/gitlab-storage, example/gitlab) ──────────────────────
GITLAB_URL=              # e.g. https://gitlab.example.com
GITLAB_PROJECT=          # URL-encoded "namespace/project", e.g. your-group%2Fnetconfigs
GITLAB_TOKEN=            # glpat-xxxxxxxxxxxx
BRANCH=main
